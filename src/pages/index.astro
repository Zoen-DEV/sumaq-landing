---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const marqueeItems = [
  'Hecho a mano',
  'Detalle al pixel',
  'Rápido sin atajos',
  'A medida, no a molde',
  'Diseño + código',
  'Demo cada semana',
  'Precio cerrado',
  'Sin briefs eternos',
];

const services = [
  {
    n: '01',
    title: 'Webs a medida',
    body: 'Desde landings hasta ecommerce y web apps. Las pensamos como parte de tu marca y las desarrollamos para que aguanten cuando crezcas.',
    capabilities: ['Landing pages', 'Corporativas', 'Ecommerce', 'Web apps', 'SEO técnico'],
  },
  {
    n: '02',
    title: 'Apps móviles',
    body: 'iOS, Android o multiplataforma. Que se sientan rápidas para tu usuario y sean fáciles de mantener cuando te las entreguemos.',
    capabilities: ['iOS nativo', 'Android nativo', 'React Native', 'Backend integrado', 'Distribución'],
  },
  {
    n: '03',
    title: 'Diseño & marca',
    body: 'Identidad, sistemas de diseño y UX. Para que tu marca se reconozca y tu producto se entienda solo.',
    capabilities: ['Branding', 'Logo & wordmark', 'Sistema de diseño', 'UX research', 'Auditoría visual'],
  },
];

const pillars = [
  {
    title: 'Calidad como sello',
    body: 'Cada detalle es una decisión, no un descuido. Si no podemos mostrarlo con orgullo, no sale a producción.',
  },
  {
    title: 'A medida, no a molde',
    body: 'No imponemos nuestro estilo — lo extraemos del tuyo. Cada proyecto arranca de cero, no de una plantilla.',
  },
  {
    title: 'Rápidos sin atajos',
    body: 'Usamos IA como palanca, no como reemplazo. Lo que normalmente toma tres meses, en nosotros toma tres semanas. Misma exigencia, menos espera.',
  },
];

const process = [
  { n: '01', title: 'Conversación inicial', body: 'Entendemos qué necesitas y por qué. Una conversación, no un brief de 40 páginas.' },
  { n: '02', title: 'Propuesta y plazo cerrado', body: 'Alcance claro, precio cerrado, fecha de entrega. Lo que firmamos es lo que pagas.' },
  { n: '03', title: 'Diseño y construcción', body: 'Iteramos contigo. Cada semana ves una demo del avance — no esperas al final para opinar.' },
  { n: '04', title: 'Lanzamiento y soporte', body: 'Te lo entregamos listo. Y te acompañamos los primeros 30 días para que arranque bien.' },
];

---

<BaseLayout>
  <!-- ============================================================
       BG EFFECT — dot matrix parallax
       ============================================================ -->
  <div id="bg-effect" aria-hidden="true">
    <div class="bg-dots">
      <div class="bg-dots__a"></div>
      <div class="bg-dots__b"></div>
      <div class="bg-dots__c"></div>
    </div>
  </div>

  <Nav />

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="hero" data-section="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__mesh"></div>
      <div class="hero__glow hero__glow--a" data-parallax data-speed="-0.22"></div>
      <div class="hero__glow hero__glow--b" data-parallax data-speed="-0.14"></div>
      <div class="hero__grid"></div>
    </div>

    <div class="hero__inner">
      <p class="eyebrow" data-reveal>
        <span class="eyebrow__dot"></span>
        Estudio digital · Disponible para nuevos proyectos
      </p>
      <h1 class="hero__title" data-reveal-words>
        Hacemos webs y apps que la gente realmente quiere usar.
      </h1>
      <p class="hero__sub" data-reveal>
        Webs, apps móviles y sistemas de marca. Hechos a medida, entregados en semanas — no en meses.
      </p>
      <p class="hero__story" data-reveal>
        <em>Sumaq</em> significa <em>excelente</em>. Una palabra. Un estándar.
      </p>
      <div class="hero__cta" data-reveal>
        <a href="#contacto" class="btn" data-magnetic data-magnetic-strength="0.25">
          <span>Cuéntame qué necesitas</span>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" class="btn__arrow">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="#proceso" class="btn btn--ghost">Cómo trabajamos</a>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true" data-reveal>
      <span>Scroll</span>
      <span class="hero__scroll-line"></span>
    </div>
  </section>

  <!-- ============================================================
       MARQUEE
       ============================================================ -->
  <section class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span class="marquee__item">
          {item}
          <span class="marquee__sep">✦</span>
        </span>
      ))}
    </div>
  </section>

  <!-- ============================================================
       SERVICES
       ============================================================ -->
  <section class="services" id="servicios">
    <header class="section-head services__head">
      <p class="eyebrow" data-reveal>Qué hacemos</p>
      <h2 class="section-title" data-reveal-words>Tres frentes. Una sola vara.</h2>
      <p class="section-lead" data-reveal>
        Webs, mobile y marca. Mismo nivel de detalle en los tres — lo único que cambia es el formato.
      </p>
    </header>

    <div class="services__grid">
      {services.map((s) => (
        <a class="service" href="#contacto" data-service>
          <header class="service__head">
            <span class="service__n">{s.n}</span>
            <h3 class="service__title">{s.title}</h3>
          </header>
          <p class="service__body">{s.body}</p>
          <ul class="service__caps">
            {s.capabilities.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
          <div class="service__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20">
              <path d="M5 12h14M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Indicadores del carrusel (solo mobile) -->
    <div class="services__nav" data-services-nav>
      {services.map((s) => (
        <button class="services__dot" type="button" data-services-dot aria-label={`Ver ${s.title}`}>
          <span class="services__dot-fill" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <!-- ============================================================
       PILLARS
       ============================================================ -->
  <section class="pillars" id="pilares">
    <header class="section-head pillars__head">
      <p class="eyebrow" data-reveal>Tres pilares</p>
      <h2 class="section-title" data-reveal-words>Cómo definimos calidad.</h2>
    </header>
    <div class="pillars__grid">
      {pillars.map((p, i) => (
        <article class="pillar" data-pillar>
          <span class="pillar__line" aria-hidden="true"></span>
          <span class="pillar__index" data-pillar-content>0{i + 1}</span>
          <h3 class="pillar__title" data-pillar-content>{p.title}</h3>
          <p class="pillar__body" data-pillar-content>{p.body}</p>
        </article>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <!-- ============================================================
       PROCESS
       ============================================================ -->
  <section class="process" id="proceso">
    <header class="section-head process__head">
      <p class="eyebrow" data-reveal>Cómo trabajamos</p>
      <h2 class="section-title" data-reveal-words>Cuatro pasos. Sin sorpresas.</h2>
    </header>

    <ol class="process__list" data-process>
      {process.map((s) => (
        <li class="process__item" data-process-item>
          <span class="process__n">{s.n}</span>
          <div class="process__content">
            <h3 class="process__title">{s.title}</h3>
            <p class="process__body">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================================================
       MANIFESTO — pinned + scrub
       ============================================================ -->
  <section class="manifesto" data-manifesto>
    <div class="manifesto__inner">
      <p class="manifesto__eyebrow">— principio operativo</p>
      <p class="manifesto__quote">El trabajo habla más que el copy.</p>
      <p class="manifesto__attr">Sumaq · 2026</p>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============================================================
       CONTACT
       ============================================================ -->
  <section class="contact" id="contacto">
    <div class="contact__inner">
      <p class="eyebrow" data-reveal>Contacto</p>
      <h2 class="contact__title" data-reveal-words>¿Tienes una idea?</h2>
      <p class="contact__body" data-reveal>
        Escríbenos. Te respondemos en menos de 24h hábiles — sin formularios ni intermediarios.
      </p>
      <div class="contact__actions" data-reveal>
        <a href="mailto:holasumaqstudios@gmail.com" class="contact__email" data-magnetic data-magnetic-strength="0.15">
          holasumaqstudios@gmail.com
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <!-- ============================================================
       MOTION SCRIPT — GSAP ScrollTrigger
       ============================================================ -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ============================================================
       SERVICIOS — carrusel auto + manual (solo mobile)
       Cada card rota cada ROTATE_MS con un indicador de progreso.
       El swipe nativo (scroll-snap) y el click en los puntos también
       cambian de card y reinician el temporizador.
       ============================================================ */
    (() => {
      const grid = document.querySelector<HTMLElement>('.services__grid');
      const nav = document.querySelector<HTMLElement>('[data-services-nav]');
      if (!grid || !nav) return;
      const gridEl = grid; // alias con tipo ya estrechado para usar en closures

      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.service'));
      const dots = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-services-dot]'));
      const fills = dots.map((d) => d.querySelector<HTMLElement>('.services__dot-fill'));
      if (cards.length < 2) return;

      const ROTATE_MS = 13000;
      const mq = window.matchMedia('(max-width: 640px)');

      let enabled = false;
      let active = 0;
      let rafId = 0;
      let progStart = 0;   // performance.now() del último reinicio
      let progElapsed = 0; // acumulado mientras está en pausa
      let paused = false;  // pausa por visibilidad de pestaña
      let scrolling = false;
      let scrollTimer = 0;

      const center = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return r.left + r.width / 2;
      };

      function nearestCard() {
        const target = center(gridEl);
        let best = 0;
        let bestDist = Infinity;
        cards.forEach((c, i) => {
          const d = Math.abs(center(c) - target);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        return best;
      }

      function scrollToCard(i: number) {
        const card = cards[i];
        if (!card) return;
        const delta = center(card) - center(gridEl);
        gridEl.scrollTo({ left: gridEl.scrollLeft + delta, behavior: reduced ? 'auto' : 'smooth' });
      }

      function setActive(i: number) {
        active = i;
        dots.forEach((d, idx) => d.classList.toggle('is-active', idx === i));
        fills.forEach((f, idx) => {
          if (f) f.style.transform = reduced && idx === i ? 'scaleX(1)' : 'scaleX(0)';
        });
      }

      function resetProgress() {
        progStart = performance.now();
        progElapsed = 0;
      }

      function goTo(i: number) {
        setActive(i);
        resetProgress();
        scrollToCard(i);
      }

      function loop(now: number) {
        if (!enabled) return;
        if (!paused && !scrolling && !reduced) {
          const elapsed = progElapsed + (now - progStart);
          const p = Math.min(elapsed / ROTATE_MS, 1);
          const f = fills[active];
          if (f) f.style.transform = `scaleX(${p})`;
          if (p >= 1) goTo((active + 1) % cards.length);
        }
        rafId = requestAnimationFrame(loop);
      }

      function enable() {
        if (enabled) return;
        enabled = true;
        setActive(nearestCard());
        resetProgress();
        paused = false;
        scrolling = false;
        if (!reduced) {
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(loop);
        }
      }

      function disable() {
        if (!enabled) return;
        enabled = false;
        cancelAnimationFrame(rafId);
        dots.forEach((d) => d.classList.remove('is-active'));
        fills.forEach((f) => { if (f) f.style.transform = ''; });
      }

      // Swipe / scroll manual: pausa el progreso y, al asentarse, sincroniza.
      grid.addEventListener('scroll', () => {
        if (!enabled) return;
        scrolling = true;
        clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          scrolling = false;
          setActive(nearestCard());
          resetProgress();
        }, 140);
      }, { passive: true });

      // Click en un punto → salta a esa card.
      dots.forEach((d, i) => d.addEventListener('click', () => {
        if (enabled) goTo(i);
      }));

      // Pausa el temporizador cuando la pestaña no está visible.
      document.addEventListener('visibilitychange', () => {
        if (!enabled) return;
        if (document.hidden) {
          if (!paused) { paused = true; progElapsed += performance.now() - progStart; }
        } else if (paused) {
          paused = false;
          progStart = performance.now();
        }
      });

      const apply = () => (mq.matches ? enable() : disable());
      mq.addEventListener('change', apply);
      apply();
    })();

    if (reduced) {
      ScrollTrigger.refresh();
    } else {
      /* ---------- Dot matrix parallax ---------- */
      ([
        ['.bg-dots__a', '0px',   '0px',   '60px'],
        ['.bg-dots__b', '11px',  '11px', '171px'],
        ['.bg-dots__c', '23px',  '23px', '323px'],
      ] as [string, string, string, string][]).forEach(([sel, x, yStart, yEnd]) => {
        const el = document.querySelector<HTMLElement>(sel);
        if (!el) return;
        gsap.fromTo(el,
          { backgroundPosition: `${x} ${yStart}` },
          {
            backgroundPosition: `${x} ${yEnd}`,
            ease: 'none',
            scrollTrigger: { trigger: document.documentElement, start: 'top top', end: 'bottom bottom', scrub: true },
          }
        );
      });

      /* ---------- Reveal: word-by-word ---------- */
      document.querySelectorAll<HTMLElement>('[data-reveal-words]').forEach((el) => {
        const text = el.textContent ?? '';
        el.textContent = '';
        const words = text.trim().split(/\s+/);
        const frag = document.createDocumentFragment();
        words.forEach((w, i) => {
          const outer = document.createElement('span');
          outer.className = 'reveal-word';
          const inner = document.createElement('span');
          inner.className = 'reveal-word__inner';
          inner.textContent = w;
          outer.appendChild(inner);
          frag.appendChild(outer);
          if (i < words.length - 1) frag.appendChild(document.createTextNode(' '));
        });
        el.appendChild(frag);

        const tl = gsap.timeline({
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        });
        // El padre tiene opacity:0 vía CSS (anti-FOUC). Al dispararse, lo liberamos
        // y animamos los hijos desde su estado oculto.
        tl.set(el, { opacity: 1 }).from(el.querySelectorAll('.reveal-word__inner'), {
          yPercent: 110,
          opacity: 0,
          duration: 0.9,
          ease: 'expo.out',
          stagger: 0.045,
        });
      });

      /* ---------- Reveal: simple ---------- */
      // Usamos fromTo (no from) porque el CSS aplica opacity:0 al elemento — gsap.from
      // tomaría ese valor como destino y la animación quedaría "de 0 a 0".
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.fromTo(
          el,
          { y: 22, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.75,
            ease: 'power3.out',
            scrollTrigger: { trigger: el, start: 'top 90%', once: true },
          },
        );
      });

      /* ---------- Reveal: cards (batch, stagger by entry) ---------- */
      ScrollTrigger.batch('[data-reveal-card]', {
        start: 'top 85%',
        once: true,
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { y: 32, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.85,
              ease: 'power3.out',
              stagger: 0.08,
              overwrite: true,
            },
          );
        },
      });

      /* ---------- Services: stagger reveal + mouse-tracking spotlight ---------- */
      const servicesSection = document.querySelector<HTMLElement>('#servicios');
      if (servicesSection) {
        const serviceCards = servicesSection.querySelectorAll<HTMLElement>('[data-service]');

        gsap.fromTo(
          serviceCards,
          { y: 24, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.7,
            ease: 'power3.out',
            stagger: 0.12,
            scrollTrigger: { trigger: servicesSection, start: 'top 75%', once: true },
          },
        );

        serviceCards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${((e.clientX - rect.left) / rect.width) * 100}%`);
            card.style.setProperty('--my', `${((e.clientY - rect.top) / rect.height) * 100}%`);
          });
          card.addEventListener('mouseleave', () => {
            card.style.setProperty('--mx', '50%');
            card.style.setProperty('--my', '0%');
          });
        });
      }

      /* ---------- Pillars: líneas dibujan → contenido fade ---------- */
      const pillarsSection = document.querySelector<HTMLElement>('#pilares');
      if (pillarsSection) {
        const lines = pillarsSection.querySelectorAll<HTMLElement>('.pillar__line');
        const isMobile = window.innerWidth < 640;
        const tl = gsap.timeline({
          scrollTrigger: { trigger: pillarsSection, start: 'top 75%', once: true },
        });
        tl.to(lines, {
          [isMobile ? 'scaleX' : 'scaleY']: 1,
          duration: 0.65,
          ease: 'power3.out',
          stagger: 0.1,
          transformOrigin: isMobile ? 'left center' : 'top center',
        });
        tl.fromTo(
          pillarsSection.querySelectorAll<HTMLElement>('[data-pillar-content]'),
          { y: 14, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.55, ease: 'power3.out', stagger: 0.06 },
          '-=0.3',
        );
      }

      /* ---------- Parallax ---------- */
      gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach((el) => {
        const speed = parseFloat(el.dataset.speed ?? '-0.15');
        gsap.to(el, {
          yPercent: speed * 100,
          ease: 'none',
          scrollTrigger: {
            trigger: el.closest('[data-section], section') ?? el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });
      });

      /* ---------- Process: stagger entry + active state per item ---------- */
      const processList = document.querySelector<HTMLElement>('[data-process]');
      if (processList) {
        const processItems = processList.querySelectorAll<HTMLElement>('[data-process-item]');

        gsap.fromTo(
          processItems,
          { y: 16, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.75,
            ease: 'power3.out',
            stagger: 0.10,
            scrollTrigger: { trigger: processList, start: 'top 80%', once: true },
          },
        );

      }

      /* ---------- Manifesto pin + scrub ---------- */
      const manifesto = document.querySelector<HTMLElement>('[data-manifesto]');
      if (manifesto) {
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: manifesto,
            start: 'top top',
            end: '+=90%',
            pin: true,
            scrub: 0.6,
          },
        });
        tl.from(manifesto.querySelector('.manifesto__eyebrow'), {
          opacity: 0,
          y: 12,
          ease: 'none',
        })
          .from(
            manifesto.querySelector('.manifesto__quote'),
            { scale: 0.9, opacity: 0.25, ease: 'none' },
            '<0.05',
          )
          .from(
            manifesto.querySelector('.manifesto__attr'),
            { opacity: 0, y: 16, ease: 'none' },
            '<0.4',
          );
      }

      /* ---------- Magnetic hover (CTAs, links destacados) ---------- */
      const magnets = document.querySelectorAll<HTMLElement>('[data-magnetic]');
      magnets.forEach((el) => {
        const strength = parseFloat(el.dataset.magneticStrength ?? '0.25');
        const xTo = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
        const yTo = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });

        el.addEventListener('pointermove', (e) => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          xTo(x * strength);
          yTo(y * strength);
        });
        el.addEventListener('pointerleave', () => {
          gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
      });

      /* ---------- Refresh tras carga ---------- */
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>

<style>
  /* ============================================================
     CONTAINER
     ============================================================ */
  .hero__inner,
  .services,
  .pillars,
  .process,
  .manifesto__inner,
  .contact__inner,
  .section-head {
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--container-pad);
    padding-right: var(--container-pad);
  }

  /* ============================================================
     SECTION HEAD
     ============================================================ */
  .section-head {
    margin-bottom: 64px;
    max-width: 720px;
  }
  .section-lead {
    font-size: var(--text-lg);
    color: var(--color-muted-foreground);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
    margin-top: 12px;
  }

  /* ============================================================
     UTILITIES
     ============================================================ */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    margin-bottom: 20px;
  }
  .eyebrow__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 0 4px color-mix(in srgb, #10b981 22%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px color-mix(in srgb, #10b981 22%, transparent); }
    50%      { box-shadow: 0 0 0 8px color-mix(in srgb, #10b981 0%, transparent); }
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
