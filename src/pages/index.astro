    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--marquee-fade),
      #000 calc(100% - var(--marquee-fade)),
      transparent 100%
    );
  }
  .marquee__track {
    display: flex;
