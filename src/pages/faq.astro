---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: '¿Cuánto cuesta un proyecto?',
    a: 'Depende del alcance. Cerramos precio fijo al inicio, basado en lo que necesitás — sin tarifas variables ni adicionales sorpresa a mitad de camino.',
  },
  {
    q: '¿En cuánto tiempo entregan?',
    a: 'Entre 3 y 8 semanas, según el proyecto. La fecha la fijamos antes de arrancar y la respetamos.',
  },
  {
    q: '¿Trabajan con clientes fuera del país?',
    a: 'Sí. Reuniones por video, todo lo demás asíncrono. La distancia deja de ser un problema cuando hay método.',
  },
  {
    q: '¿Usan IA en el proceso?',
    a: 'Sí, pero como palanca. Acelera lo mecánico; las decisiones de diseño y arquitectura las seguimos tomando nosotros. Por eso entregamos más rápido sin bajar la barra.',
  },
  {
    q: '¿Qué pasa cuando el proyecto termina?',
    a: '30 días de soporte incluidos. Después podés seguir con un retainer mensual o quedarte el código documentado para manejarlo internamente.',
  },
];
---

<BaseLayout title="FAQ · Sumaq" description="Respuestas a las preguntas más frecuentes sobre cómo trabajamos en Sumaq Studios.">
  <Nav />

  <main>
    <section class="faq">
      <header class="section-head">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h1 class="section-title" data-reveal-words>Lo que suelen preguntarnos.</h1>
      </header>

      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item" data-reveal-card>
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14">
                  <path d="M3 8h10M8 3v10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="faq__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

  </main>

  <Footer />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      document.querySelectorAll<HTMLElement>('[data-reveal-words]').forEach((el) => {
        const text = el.textContent ?? '';
        el.textContent = '';
        const words = text.trim().split(/\s+/);
        const frag = document.createDocumentFragment();
        words.forEach((w, i) => {
          const outer = document.createElement('span');
          outer.className = 'reveal-word';
          const inner = document.createElement('span');
          inner.className = 'reveal-word__inner';
          inner.textContent = w;
          outer.appendChild(inner);
          frag.appendChild(outer);
          if (i < words.length - 1) frag.appendChild(document.createTextNode(' '));
        });
        el.appendChild(frag);

        const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
        tl.set(el, { opacity: 1 }).from(el.querySelectorAll('.reveal-word__inner'), {
          yPercent: 110, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.045,
        });
      });

      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.fromTo(el, { y: 22, opacity: 0 }, {
          y: 0, opacity: 1, duration: 0.75, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 90%', once: true },
        });
      });

      ScrollTrigger.batch('[data-reveal-card]', {
        start: 'top 85%', once: true,
        onEnter: (batch) => {
          gsap.fromTo(batch, { y: 32, opacity: 0 }, {
            y: 0, opacity: 1, duration: 0.85, ease: 'power3.out', stagger: 0.08, overwrite: true,
          });
        },
      });

      document.querySelectorAll<HTMLDetailsElement>('.faq__item').forEach((item) => {
        const panel = item.querySelector<HTMLElement>('.faq__a');
        if (!panel) return;
        item.addEventListener('toggle', () => {
          if (item.open) {
            gsap.fromTo(panel, { height: 0, opacity: 0 }, { height: 'auto', opacity: 1, duration: 0.45, ease: 'power3.out' });
          } else {
            gsap.to(panel, { height: 0, opacity: 0, duration: 0.32, ease: 'power2.inOut' });
          }
        });
      });

      const magnets = document.querySelectorAll<HTMLElement>('[data-magnetic]');
      magnets.forEach((el) => {
        const strength = parseFloat(el.dataset.magneticStrength ?? '0.25');
        const xTo = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
        const yTo = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
        el.addEventListener('pointermove', (e) => {
          const rect = el.getBoundingClientRect();
          xTo((e.clientX - rect.left - rect.width / 2) * strength);
          yTo((e.clientY - rect.top - rect.height / 2) * strength);
        });
        el.addEventListener('pointerleave', () => {
          gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
      });

      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>

<style>
  .faq,
  .section-head {
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--container-pad);
    padding-right: var(--container-pad);
  }

  .section-head {
    margin-bottom: 64px;
    max-width: 720px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    margin-bottom: 20px;
  }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }
  .reveal-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    line-height: 1.1;
    padding-bottom: 0.08em;
  }
  .reveal-word__inner { display: inline-block; will-change: transform, opacity; }

  :global(html.js-ready) [data-reveal],
  :global(html.js-ready) [data-reveal-words],
  :global(html.js-ready) [data-reveal-card] { opacity: 0; }

  .faq {
    padding-top: 120px;
    padding-bottom: 120px;
  }
  .faq__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .faq__q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--color-foreground); }
  .faq__icon {
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    color: var(--color-muted-foreground);
    flex-shrink: 0;
    transition: transform var(--dur-slow) var(--ease-spring),
                border-color var(--dur-fast) var(--ease-out-quart),
                color var(--dur-fast) var(--ease-out-quart);
  }
  details[open] .faq__icon {
    transform: rotate(45deg);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .faq__a {
    overflow: hidden;
    height: 0;
    opacity: 0;
  }
  .faq__a p {
    padding: 0 0 28px;
    max-width: 64ch;
    font-size: var(--text-base);
    color: var(--color-muted-foreground);
    line-height: var(--leading-relaxed);
  }
  :global(html:not(.js-ready)) details[open] .faq__a {
    height: auto !important;
    opacity: 1 !important;
  }

  @media (max-width: 640px) {
    .faq { padding-top: 88px; padding-bottom: 88px; }
    .section-head { margin-bottom: 48px; }
    .section-title { font-size: clamp(1.75rem, 7vw, 2.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal], [data-reveal-card], [data-reveal-words] { opacity: 1 !important; transform: none !important; }
  }
</style>
