---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const process = [
  { n: '01', title: 'Conversación inicial', body: 'Entendemos qué necesitás y por qué. Una charla, no un brief de 40 páginas.' },
  { n: '02', title: 'Propuesta y plazo cerrado', body: 'Alcance claro, precio cerrado, fecha de entrega. Lo que firmamos es lo que pagás.' },
  { n: '03', title: 'Diseño y construcción', body: 'Iteramos con vos. Cada semana ves una demo del avance — no esperás al final para opinar.' },
  { n: '04', title: 'Lanzamiento y soporte', body: 'Te lo entregamos listo. Y te acompañamos los primeros 30 días para que aterrice bien.' },
];
---

<BaseLayout title="Proceso · Sumaq" description="Cuatro pasos, sin sorpresas. Así es cómo trabajamos en Sumaq Studios.">
  <Nav />

  <main>
    <section class="process" id="proceso">
      <header class="section-head process__head">
        <p class="eyebrow" data-reveal>Cómo trabajamos</p>
        <h1 class="section-title" data-reveal-words>Cuatro pasos. Sin sorpresas.</h1>
      </header>

      <ol class="process__list" data-process>
        {process.map((s) => (
          <li class="process__item" data-process-item>
            <span class="process__n">{s.n}</span>
            <div class="process__content">
              <h2 class="process__title">{s.title}</h2>
              <p class="process__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

  </main>

  <Footer />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      document.querySelectorAll<HTMLElement>('[data-reveal-words]').forEach((el) => {
        const text = el.textContent ?? '';
        el.textContent = '';
        const words = text.trim().split(/\s+/);
        const frag = document.createDocumentFragment();
        words.forEach((w, i) => {
          const outer = document.createElement('span');
          outer.className = 'reveal-word';
          const inner = document.createElement('span');
          inner.className = 'reveal-word__inner';
          inner.textContent = w;
          outer.appendChild(inner);
          frag.appendChild(outer);
          if (i < words.length - 1) frag.appendChild(document.createTextNode(' '));
        });
        el.appendChild(frag);

        const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
        tl.set(el, { opacity: 1 }).from(el.querySelectorAll('.reveal-word__inner'), {
          yPercent: 110, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.045,
        });
      });

      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.fromTo(el, { y: 22, opacity: 0 }, {
          y: 0, opacity: 1, duration: 0.75, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 90%', once: true },
        });
      });

      const processList = document.querySelector<HTMLElement>('[data-process]');
      if (processList) {
        const processItems = processList.querySelectorAll<HTMLElement>('[data-process-item]');
        gsap.fromTo(processItems, { y: 16, opacity: 0 }, {
          y: 0, opacity: 1, duration: 0.75, ease: 'power3.out', stagger: 0.10,
          scrollTrigger: { trigger: processList, start: 'top 80%', once: true },
        });
      }

      const magnets = document.querySelectorAll<HTMLElement>('[data-magnetic]');
      magnets.forEach((el) => {
        const strength = parseFloat(el.dataset.magneticStrength ?? '0.25');
        const xTo = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
        const yTo = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
        el.addEventListener('pointermove', (e) => {
          const rect = el.getBoundingClientRect();
          xTo((e.clientX - rect.left - rect.width / 2) * strength);
          yTo((e.clientY - rect.top - rect.height / 2) * strength);
        });
        el.addEventListener('pointerleave', () => {
          gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
      });

      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</BaseLayout>

<style>
  .process,
  .section-head {
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--container-pad);
    padding-right: var(--container-pad);
  }

  .section-head {
    margin-bottom: 64px;
    max-width: 720px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    margin-bottom: 20px;
  }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }
  .reveal-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    line-height: 1.1;
    padding-bottom: 0.08em;
  }
  .reveal-word__inner { display: inline-block; will-change: transform, opacity; }

  :global(html.js-ready) [data-reveal],
  :global(html.js-ready) [data-reveal-words],
  :global(html.js-ready) [data-process-item] { opacity: 0; }

  .process {
    padding-top: 120px;
    padding-bottom: 140px;
  }
  .process__head { max-width: none; }
  .process__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }
  .process__item {
    position: relative;
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 28px;
    padding: 36px 0;
    border-top: 1px solid var(--color-border);
    border-left: 2px solid transparent;
    transition: padding-left var(--dur-base) var(--ease-out-quart),
                border-color var(--dur-base) var(--ease-out-quart),
                background var(--dur-base) var(--ease-out-quart);
    will-change: opacity, transform;
    cursor: default;
  }
  .process__item:first-child { border-top: none; }
  .process__item:hover {
    border-left-color: var(--color-accent);
    padding-left: 16px;
    background: color-mix(in srgb, var(--color-foreground) 3%, transparent);
  }
  .process__item:hover .process__n { color: var(--color-accent); }
  .process__n {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-muted-foreground);
    letter-spacing: var(--tracking-wide);
    align-self: start;
    padding-top: 6px;
    transition: color var(--dur-base) var(--ease-out-quart);
  }
  .process__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 8px;
  }
  .process__body {
    font-size: var(--text-base);
    color: var(--color-muted-foreground);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
  }

  @media (max-width: 640px) {
    .process { padding-top: 88px; padding-bottom: 96px; }
    .process__item { grid-template-columns: 44px 1fr; gap: 16px; padding: 28px 0; }
    .section-head { margin-bottom: 48px; }
    .section-title { font-size: clamp(1.75rem, 7vw, 2.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal], [data-reveal-words], [data-process-item] { opacity: 1 !important; transform: none !important; }
  }
</style>
