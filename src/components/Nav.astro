---
const { pathname } = Astro.url;
---
<header class="nav" transition:persist>
  <div class="nav__inner">
    <a href="/" aria-label="Sumaq" class="nav__logo">
      <img src="/logo/wordmark.svg" alt="Sumaq" height="28" class="nav__logo-img nav__logo-img--light" />
      <img src="/logo/wordmark-inverted.svg" alt="" height="28" class="nav__logo-img nav__logo-img--dark" aria-hidden="true" />
    </a>
    <div class="nav__actions">
      <nav class="nav__links" aria-label="Secciones">
        <a href="/servicios">Servicios</a>
        <a href="/proceso">Proceso</a>
        <a href="/faq">FAQ</a>
      </nav>
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Cambiar tema"
        aria-pressed="false"
        title="Cambiar tema"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <line x1="12" y1="2.5" x2="12" y2="5" />
            <line x1="12" y1="19" x2="12" y2="21.5" />
            <line x1="2.5" y1="12" x2="5" y2="12" />
            <line x1="19" y1="12" x2="21.5" y2="12" />
            <line x1="5.2" y1="5.2" x2="6.9" y2="6.9" />
            <line x1="17.1" y1="17.1" x2="18.8" y2="18.8" />
            <line x1="5.2" y1="18.8" x2="6.9" y2="17.1" />
            <line x1="17.1" y1="6.9" x2="18.8" y2="5.2" />
          </g>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" />
        </svg>
      </button>
      <a href={pathname === '/' ? '#contacto' : '/#contacto'} class="nav__cta" data-magnetic data-magnetic-strength="0.18">Hablemos</a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const syncPressed = () => {
    const isDark = root.classList.contains('dark');
    toggle?.setAttribute('aria-pressed', String(isDark));
  };
  syncPressed();
  toggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    root.dataset.theme = isDark ? 'dark' : 'light';
    root.setAttribute('data-theme-switching', '');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
    requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute('data-theme-switching')));
    syncPressed();
  });

  window.addEventListener('scroll', () => {
    document.querySelector('.nav')?.classList.toggle('nav--scrolled', window.scrollY > 8);
  }, { passive: true });

  document.addEventListener('astro:after-swap', () => {
    document.querySelector('.nav')?.classList.toggle('nav--scrolled', window.scrollY > 8);
    const cta = document.querySelector<HTMLAnchorElement>('.nav__cta');
    if (cta) cta.href = window.location.pathname === '/' ? '#contacto' : '/#contacto';
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-background) 55%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: background var(--dur-base) var(--ease-out-quart),
                border-color var(--dur-base) var(--ease-out-quart);
  }
  .nav--scrolled {
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    border-bottom-color: var(--color-border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 18px;
    gap: 16px;
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--container-pad);
    padding-right: var(--container-pad);
  }
  .nav__logo { display: inline-flex; }
  .nav__logo img { height: 26px; width: auto; }
  .nav__logo-img--dark { display: none; }
  :global(html.dark) .nav__logo-img--light { display: none; }
  :global(html.dark) .nav__logo-img--dark { display: inline-block; }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav__links {
    display: flex;
    gap: 28px;
    margin-right: 8px;
  }
  .nav__links a {
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
    transition: color var(--dur-fast) var(--ease-out-quart);
    position: relative;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out-quart);
  }
  .nav__links a:hover { color: var(--color-foreground); }
  .nav__links a:hover::after { transform: scaleX(1); }

  .nav__cta {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-background);
    background: var(--color-foreground);
    padding: 9px 16px;
    border-radius: 999px;
    transition: opacity var(--dur-fast) var(--ease-out-quart);
    will-change: transform;
  }
  .nav__cta:hover { opacity: 0.88; }

  .theme-toggle {
    position: relative;
    width: 36px;
    height: 36px;
    display: inline-grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted-foreground);
    cursor: pointer;
    outline: none;
    transition: color var(--dur-fast) var(--ease-out-quart),
                border-color var(--dur-fast) var(--ease-out-quart),
                background var(--dur-fast) var(--ease-out-quart);
  }
  .theme-toggle:hover { color: var(--color-foreground); border-color: var(--color-foreground); }
  .theme-toggle__icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: transform var(--dur-slow) var(--ease-spring), opacity var(--dur-base) var(--ease-out-quart);
  }
  .theme-toggle__icon--moon { opacity: 0; transform: rotate(-45deg) scale(0.7); }
  .theme-toggle__icon--sun  { opacity: 1; transform: rotate(0) scale(1); }
  html:not(.dark) .theme-toggle__icon--sun  { opacity: 0; transform: rotate(45deg) scale(0.7); }
  html:not(.dark) .theme-toggle__icon--moon { opacity: 1; transform: rotate(0) scale(1); }

  @media (max-width: 760px) {
    .nav__links { display: none; }
  }
</style>
